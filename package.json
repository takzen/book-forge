{
  "name": "book-forge",
  "version": "1.3.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "electron": "electron .",
    "electron:dev": "concurrently -k -n \"NEXT,ELECTRON\" -c \"cyan,magenta\" \"next dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:start": "cross-env NODE_ENV=production concurrently -k -n \"NEXT,ELECTRON\" -c \"green,blue\" \"next start\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "shortcut": "node scripts/create-desktop-shortcut.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "next": "16.2.12",
    "playwright": "^1.62.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
